
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Admin";
}
<h1>Admin</h1>
@if (TempData["Message"] != null) { <div class="alert alert-success">@TempData["Message"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="row">
  <div class="col-md-6">
    <h4>Create Category</h4>
    <form method="post" asp-area="Admin" asp-controller="Admin" asp-action="CreateCategory">
      <div class="mb-3">
        <label class="form-label">Name</label>
        <input name="name" class="form-control" />
      </div>
      <div class="mb-3">
        <label class="form-label">Slug (optional)</label>
        <input name="slug" class="form-control" />
      </div>
      <button class="btn btn-success">Create</button>
    </form>
  </div>
  <div class="col-md-6">
    <h4>Upload to Category</h4>
    <form method="post" enctype="multipart/form-data" asp-area="Admin" asp-controller="Admin" asp-action="Upload">
      <div class="mb-3">
        <label class="form-label">Category</label>
        <select name="categoryId" class="form-select">
          @foreach (var c in (IEnumerable<FileGallery.Models.Category>)ViewBag.Categories)
          {
            <option value="@c.Id">@c.Name (@c.Slug)</option>
          }
        </select>
      </div>
      <div class="mb-3">
        <label class="form-label">Select file</label>
        <input type="file" name="file" class="form-control" />
      </div>
      <button class="btn btn-primary">Upload</button>
    </form>
  </div>
</div>
<hr/>
<h4>Manage Categories</h4>
<table class="table table-striped">
  <thead><tr><th>Name</th><th>Slug</th><th>Files</th><th>Actions</th></tr></thead>
  <tbody>
        @foreach (var c in (IEnumerable<FileGallery.Models.Category>)ViewBag.Categories)
  {
    <tr>
      <td>@c.Name</td>
      <td>@c.Slug</td>
      <td>@c.Files.Count</td>
      <td>
        <form method="post" asp-area="Admin" asp-controller="Admin" asp-action="DeleteCategory" asp-route-id="@c.Id" onsubmit="return confirm('Delete category?')">
          <button class="btn btn-sm btn-outline-danger">Delete</button>
        </form>
      </td>
    </tr>
  }
  </tbody>
</table>
<div class="mt-3">
  <a class="btn btn-outline-secondary" href="/Admin/Admin/PublicUpload">View Public Uploads</a>
</div>
